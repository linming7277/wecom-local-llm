# 复制为 .env 后按环境修改。不要把 .env 提交到仓库。
# 下面的 CorpID / Token / EncodingAESKey 是企业微信文档公开示例。
# 只能用于本地模拟。进程启动时如果发现这些值，会打 WARN。生产环境必须换成自己的应用配置。

APP_HOST=0.0.0.0
APP_PORT=8100
APP_ENV=dev

# 主模型。提供方只能是 ollama 或 openai。模型名不要写进业务代码。
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.8:27b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.3
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT=120
# false 时 Ollama 请求体带 "think": false。网关仍会去掉回答里的 <think> 标签。
LLM_THINK=false

# 默认不切换。设为 true 且配置了备用提供方后，主模型失败才会切换，并写 WARN 日志。
LLM_FALLBACK_ENABLED=false
# 模型名或地址留空时，沿用主模型的对应值。API Key 不沿用。
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# 知识库嵌入（M5 使用）。默认 bge-m3。
EMBED_MODEL=bge-m3
EMBED_BASE_URL=http://localhost:11434
RAG_TOP_K=4

# 企业微信（M3 / M4 使用）。生产环境换成自己的值。
WECOM_CORP_ID=wx5823bf96d3bd56c7
WECOM_AGENT_ID=218
WECOM_SECRET=
WECOM_TOKEN=QDG6eK
WECOM_ENCODING_AES_KEY=jWmYm7qr5nMoAUwZRjGtBxmz3KA1tkAj3ykkR6q2B2C
WECOM_WEBHOOK_KEY=

# 每日咨询摘要（M3 使用）
REPORT_HOUR=18
REPORT_MINUTE=0
REPORT_TIMEZONE=Asia/Shanghai

SESSION_MAX_TURNS=8
DATABASE_URL=sqlite:///./data/wecom.db

# 非空时，/admin/* 要求请求头 X-Admin-Token。为空时只接受本机调用。
ADMIN_TOKEN=
